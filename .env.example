# Copia este archivo como .env y rellena tus datos.
# Nunca subas el .env a GitHub: contiene credenciales privadas.

# Dominio de la tienda (acepta 'games4you-k5xbi4h0', 'games4you-k5xbi4h0.myshopify.com'
# o la URL completa con /admin).
SHOPIFY_SHOP=games4you-k5xbi4h0.myshopify.com

# Client ID y Client Secret de la app instalada en el Dev Dashboard.
# El secreto empieza por shpss_ y NO es un Admin API access token (shpat_).
SHOPIFY_CLIENT_ID=tu-client-id
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Valores heredados del primer enfoque (REST + ShopifyAPI). No son necesarios
# para shopify_client.py ni para scripts/poblar_catalogo.py.
SHOPIFY_STORE_URL=games4you-k5xbi4h0.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-10

# Puerto opcional para la API HTTP del carrito (scripts/api_carrito.py).
PUERTO_API=8000
